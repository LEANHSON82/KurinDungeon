file(GLOB_RECURSE files "${CORE_DIR}/*.h" "${CORE_DIR}/*.cpp")
set(violations "")
foreach(file ${files})
    file(STRINGS "${file}" lines REGEX "#include [<\"](raylib|raymath|rlgl|game/)")
    if(lines)
        list(APPEND violations "${file}: ${lines}")
    endif()
endforeach()

if(violations)
    string(REPLACE ";" "\n" message "${violations}")
    message(FATAL_ERROR "src/core must not depend on raylib or src/game:\n${message}")
endif()
message(STATUS "src/core is free of raylib and game includes")
